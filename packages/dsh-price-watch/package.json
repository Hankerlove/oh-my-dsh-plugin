{
  "name": "@ultraslow/dsh-price-watch",
  "version": "0.1.0",
  "description": "Flight price watch for the DeepSeek Harness Web UI: pick a route and a date, let the plugin poll Ctrip's public lowest-price calendar, keep a price history, draw it in a sidebar panel, and push Feishu cards when the price hits a target or makes a new high or low.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "host",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "flight",
    "price-watch",
    "ctrip",
    "feishu"
  ],
  "homepage": "https://github.com/Hankerlove/oh-my-dsh-plugin/tree/main/packages/dsh-price-watch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hankerlove/oh-my-dsh-plugin.git",
    "directory": "packages/dsh-price-watch"
  },
  "bugs": {
    "url": "https://github.com/Hankerlove/oh-my-dsh-plugin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.1.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
