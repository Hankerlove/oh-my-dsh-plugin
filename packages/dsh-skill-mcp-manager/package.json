{
  "name": "@ultraslow/dsh-skill-mcp-manager",
  "version": "0.1.0",
  "description": "Workspace-scoped Skill / MCP manager for the DeepSeek Harness Web UI: every skill shown with its real discovery rank, source and directory, per-skill or bulk visibility toggles that save context, per-workspace MCP servers, and global MCP servers written to the profile cordis.patch.yml.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "docs/screenshot-skills.png",
    "docs/screenshot-skills-dark.png",
    "docs/screenshot-skills-drag.png",
    "docs/screenshot-mcp.png"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "mcp",
    "workspace"
  ],
  "homepage": "https://github.com/Hankerlove/oh-my-dsh-plugin/tree/main/packages/dsh-skill-mcp-manager",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hankerlove/oh-my-dsh-plugin.git",
    "directory": "packages/dsh-skill-mcp-manager"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  }
}
